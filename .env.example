# 默认使用免费的本地演示模型，不会发起外部网络请求。
LLM_PROVIDER=demo

# 只有明确改为 openai_compatible 后，FastAPI 启动时才会调用外部模型服务。
# 请在 PowerShell 当前窗口中设置真实密钥；不要把真实密钥写入此文件或 Git。
# LLM_PROVIDER=openai_compatible
# OPENAI_COMPATIBLE_BASE_URL=https://your-compatible-endpoint.example/v1
# OPENAI_COMPATIBLE_API_KEY=replace-with-your-api-key
# OPENAI_COMPATIBLE_MODEL=replace-with-your-model-name
# OPENAI_COMPATIBLE_TIMEOUT_SECONDS=30
# 可选值：json_object（默认，兼容性更好）或 json_schema（服务明确支持时使用）。
# OPENAI_COMPATIBLE_STRUCTURED_OUTPUT_MODE=json_object
